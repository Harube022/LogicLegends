  quizPanel: {fileID: 325880916}
  safeAreaPanel: {fileID: 1574430812}
  questionTextUI: {fileID: 325880915}
  answerFeedbackSeconds: 2.5
  challenges:
  - topicName: Conjunction
    questionsPool:
    - questionText: It is only true when both statements are true.
      options:
      - Exclusive OR
      - Conjunction
      - Biconditional
      - Disjunction
      correctOptionIndex: 1
    - questionText: Both statements must be true for the whole statement to be true.
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 0
    - questionText: I combine two statements using the word AND.
      options:
      - Exclusive OR
      - Biconditional
      - Conjunction
      - Disjunction
      correctOptionIndex: 2
    - questionText: If even one of the two statements is false, the entire statement
        becomes false.
      options:
      - Exclusive OR
      - Biconditional
      - Disjunction
      - Conjunction
      correctOptionIndex: 3
    - questionText: Given P and Q, I am true only when P is true and Q is true.
      options:
      - Exclusive OR
      - Conjunction
      - Biconditional
      - Disjunction
      correctOptionIndex: 1
    - questionText: "My symbol is \u2227, and I require both sides to hold true."
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 0
    - questionText: P is true. Q is true. Therefore, P ___ Q is true. What operation
        belongs between them?
      options:
      - Exclusive OR
      - Biconditional
      - Conjunction
      - Disjunction
      correctOptionIndex: 2
    - questionText: 'Four possibilities exist: TT, TF, FT, and FF. Only TT gives
        me a true result.'
      options:
      - Exclusive OR
      - Biconditional
      - Disjunction
      - Conjunction
      correctOptionIndex: 3
    - questionText: The gate opens only if you possess the key AND activate the switch.
        Which logical operation does this represent?
      options:
      - Exclusive OR
      - Conjunction
      - Biconditional
      - Disjunction
      correctOptionIndex: 1
    - questionText: "Two conditions guard the path. Satisfying only one is not enough\u2014you
        must satisfy both."
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 0
    roomChoiceCanvas: {fileID: 739869761}
    choiceDoors:
    - {fileID: 501153630}
    - {fileID: 787868603}
    - {fileID: 208739585}
    - {fileID: 1377809312}
    topicSpawnPoint: {fileID: 1755672906}
    hintBoard: {fileID: 1309349939}
  - topicName: Disjunction
    questionsPool:
    - questionText: It is true when at least one statement is true.
      options:
      - Conjunction
      - Exclusive OR
      - Disjunction
      - Biconditional
      correctOptionIndex: 2
    - questionText: I combine two statements using the word OR.
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 3
    - questionText: I am false only when both statements are false.
      options:
      - Disjunction
      - Conjunction
      - Exclusive OR
      - Biconditional
      correctOptionIndex: 1
    - questionText: Given P and Q, I am true if P is true, Q is true, or both are
        true.
      options:
      - Conjunction
      - Disjunction
      - Exclusive OR
      - Biconditional
      correctOptionIndex: 1
    - questionText: "My symbol is \u2228, and only one side needs to be true for
        me to be true."
      options:
      - Conjunction
      - Exclusive OR
      - Disjunction
      - Biconditional
      correctOptionIndex: 2
    - questionText: P is false, but Q is true. Even so, P ___ Q is true. What operation
        belongs between them?
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 3
    - questionText: 'Four possibilities exist: TT, TF, FT, and FF. I am true in every
        case except FF.'
      options:
      - Disjunction
      - Conjunction
      - Exclusive OR
      - Biconditional
      correctOptionIndex: 0
    - questionText: The gate opens if you possess the key OR know the secret code.
        Either condition is enough. Which logical operation does this represent?
      options:
      - Conjunction
      - Disjunction
      - Exclusive OR
      - Biconditional
      correctOptionIndex: 1
    - questionText: Two paths can activate the mechanism. Either path may succeed,
        and activating both also works.
      options:
      - Conjunction
      - Exclusive OR
      - Disjunction
      - Biconditional
      correctOptionIndex: 2
    - questionText: You don't need both conditions to succeed. One true condition
        is enough, but two true conditions work as well.
      options:
      - Conjunction
      - Exclusive OR
      - Biconditional
      - Disjunction
      correctOptionIndex: 3
    roomChoiceCanvas: {fileID: 663565263}
    choiceDoors:
    - {fileID: 995166498}
    - {fileID: 1844050405}
    - {fileID: 1729574118}
    - {fileID: 1307875938}
    topicSpawnPoint: {fileID: 1818508646}
    hintBoard: {fileID: 786922124}
  - topicName: Exclusive OR
    questionsPool:
    - questionText: It is true only when exactly one statement is true.
      options:
      - Disjunction
      - Biconditional
      - Conjunction
      - Exclusive OR
      correctOptionIndex: 3
    - questionText: I become true when one statement is true and the other is false.
      options:
      - Exclusive OR
      - Disjunction
      - Biconditional
      - Conjunction
      correctOptionIndex: 0
    - questionText: If both statements have the same truth value, I become false.
      options:
      - Disjunction
      - Exclusive OR
      - Biconditional
      - Conjunction
      correctOptionIndex: 1
    - questionText: Given P and Q, I am true when P is true or Q is true, but not
        both.
      options:
      - Disjunction
      - Biconditional
      - Exclusive OR
      - Conjunction
      correctOptionIndex: 2
    - questionText: I require the two statements to have different truth values for
        the result to be true.
      options:
      - Disjunction
      - Biconditional
      - Conjunction
      - Exclusive OR
      correctOptionIndex: 3
    - questionText: P is true and Q is false. The resulting statement is true. But
        if both become true, the result becomes false.
      options:
      - Exclusive OR
      - Disjunction
      - Biconditional
      - Conjunction
      correctOptionIndex: 0
    - questionText: 'Four possibilities exist: TT, TF, FT, and FF. Only TF and FT
        make me true.'
      options:
      - Disjunction
      - Exclusive OR
      - Biconditional
      - Conjunction
      correctOptionIndex: 1
    - questionText: Two switches control the gate. Activate either one to open it,
        but activating both will keep it closed.
      options:
      - Disjunction
      - Biconditional
      - Exclusive OR
      - Conjunction
      correctOptionIndex: 2
    - questionText: You may choose the sword or the shield, but choosing both will
        not satisfy the condition.
      options:
      - Disjunction
      - Biconditional
      - Conjunction
      - Exclusive OR
      correctOptionIndex: 3
    - questionText: 'I resemble OR, but there is one important restriction: both
        statements cannot be true at the same time.'
      options:
      - Exclusive OR
      - Disjunction
      - Biconditional
      - Conjunction
      correctOptionIndex: 0
    roomChoiceCanvas: {fileID: 1869334697}
    choiceDoors:
    - {fileID: 2025180025}
    - {fileID: 2061374804}
    - {fileID: 1421860548}
    - {fileID: 426082871}
    topicSpawnPoint: {fileID: 27035736}
    hintBoard: {fileID: 2007710495}
  - topicName: Conditional
    questionsPool:
    - questionText: It is false only when the first statement is true and the second
        statement is false
      options:
      - Conditional
      - Conjunction
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: 'I connect two statements in the form: If P, then Q.'
      options:
      - Conjunction
      - Conditional
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    - questionText: 'I make a promise: whenever the first statement is true, the
        second statement must also be true.'
      options:
      - Conjunction
      - Biconditional
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 2
    - questionText: "Given P and Q, I am written as P \u2192 Q."
      options:
      - Conjunction
      - Biconditional
      - 'Exclusive OR '
      - Conditional
      correctOptionIndex: 3
    - questionText: When my first statement is true, but my second statement is false,
        the entire statement becomes false.
      options:
      - Conditional
      - Conjunction
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: 'Four possibilities exist: TT, TF, FT, and FF. Only TF makes
        me false.'
      options:
      - Conjunction
      - Conditional
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    - questionText: P is true and Q is true, so 'If P, then Q' is satisfied. Which
        logical operation does this represent?
      options:
      - Conjunction
      - Biconditional
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 2
    - questionText: If you defeat the guardian, then the gate will open. Which logical
        operation describes this condition?
      options:
      - Conjunction
      - Biconditional
      - 'Exclusive OR '
      - Conditional
      correctOptionIndex: 3
    - questionText: 'The rule says: If the torch is lit, then the hidden passage
        will appear.'
      options:
      - Conditional
      - Conjunction
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: "My symbol is \u2192. The statement before me is the condition,
        while the statement after me is the consequence."
      options:
      - Conjunction
      - Conditional
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    roomChoiceCanvas: {fileID: 624272468}
    choiceDoors:
    - {fileID: 1487620174}
    - {fileID: 1887159945}
    - {fileID: 1981247511}
    - {fileID: 326782642}
    topicSpawnPoint: {fileID: 2096429220}
    hintBoard: {fileID: 1668108364}
  - topicName: Biconditional
    questionsPool:
    - questionText: It is true when both statements have the same truth value.
      options:
      - Biconditional
      - Conjunction
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: I am true when both statements are true or when both statements
        are false.
      options:
      - Conjunction
      - Biconditional
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    - questionText: I become false whenever the two statements have different truth
        values.
      options:
      - Conjunction
      - Conditional
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 2
    - questionText: "Given P and Q, I am written as P \u2194 Q."
      options:
      - Conjunction
      - Conditional
      - 'Exclusive OR '
      - Biconditional
      correctOptionIndex: 3
    - questionText: I connect two statements where each one implies the other.
      options:
      - Biconditional
      - Conjunction
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: 'Four possibilities exist: TT, TF, FT, and FF. Only TT and FF
        make me true.'
      options:
      - Conjunction
      - Biconditional
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    - questionText: P is true and Q is true, so the statement is true. If both become
        false, the statement remains true.
      options:
      - Conjunction
      - Conditional
      - Biconditional
      - 'Exclusive OR '
      correctOptionIndex: 2
    - questionText: The gate opens if the two magical switches are either both activated
        or both deactivated.
      options:
      - Conjunction
      - Conditional
      - 'Exclusive OR '
      - Biconditional
      correctOptionIndex: 3
    - questionText: The two conditions must agree. If one is true while the other
        is false, the condition fails.
      options:
      - Biconditional
      - Conjunction
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 0
    - questionText: "My symbol is \u2194, and I express that one statement is true
        exactly when the other statement is true."
      options:
      - Conjunction
      - Biconditional
      - Conditional
      - 'Exclusive OR '
      correctOptionIndex: 1
    roomChoiceCanvas: {fileID: 379839360}
    choiceDoors:
    - {fileID: 1136486560}
    - {fileID: 2013147806}
    - {fileID: 1068188798}
    - {fileID: 979192140}
    topicSpawnPoint: {fileID: 1489718293}
    hintBoard: {fileID: 1303439668}
