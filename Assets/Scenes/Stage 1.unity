  taskScribbleClip: {fileID: 8300000, guid: d234e554f0fb2b2448ef89d299351b19, type: 3}
  scribbleVolume: 0.5
  wizardVoiceSource: {fileID: 5198640598299590359}
  wizardTalkVolume: 0.7
  dialogueEntries:
  - text: "Welcome\u2026 to the OR Challenge."
    voiceClip: {fileID: 8300000, guid: 37c1521bbab28c142a575bc0358265ef, type: 3}
  - text: "In this second trial\u2026 you will learn how the OR logic gate works."
    voiceClip: {fileID: 8300000, guid: 3c12c07555e22ef4983bec0d908f21d3, type: 3}
  - text: "The OR gate evaluates two conditions\u2026 and unlike the AND gate\u2026
      it requires only one TRUE condition to produce a TRUE result."
    voiceClip: {fileID: 8300000, guid: a228fe6cf17543b408a5e92d45509a04, type: 3}
  - text: "This means the outcome will be TRUE\u2026 if the first condition is TRUE\u2026\r\nor
      if the second condition is TRUE\u2026\r\nor if both conditions are TRUE."
    voiceClip: {fileID: 8300000, guid: 144934862163f664088388552fa0ad94, type: 3}
  - text: "Only when both conditions are FALSE\u2026 will the result be FALSE."
    voiceClip: {fileID: 8300000, guid: 7c2937d898e7f9d46a1dd1e717998e38, type: 3}
  - text: "To complete this challenge\u2026 you must find and submit an item that
      satisfies at least one of the given conditions."
    voiceClip: {fileID: 8300000, guid: 2b41690c325a89b468b0550d90036ba1, type: 3}
  - text: 'Example scenario: '
    voiceClip: {fileID: 8300000, guid: bcd4587c06bb7244dade964c1133485b, type: 3}
  - text: "Bring me\u2026 a berry fruit\u2026 or a red fruit\u2026\r\nand place it
      in the basket for confirmation."
    voiceClip: {fileID: 8300000, guid: 2fefa1e5b31272d48bcd6a5d67b0babe, type: 3}
  - text: "Presenting the correct item\u2026 will open the OR Gate\u2026 and allow
      you to proceed."
    voiceClip: {fileID: 8300000, guid: 19329a458ae329e4ebe29b8d50cab76f, type: 3}
  - text: "But choose poorly\u2026 and you will lose a heart."
    voiceClip: {fileID: 8300000, guid: 12bf207fe47142a44833c5eebf52fef4, type: 3}
  - text: "Remember\u2026 in an OR logic gate\u2026 only one correct condition is
      needed."
    voiceClip: {fileID: 8300000, guid: b07f2528394bfdc4e933a0b90dbea752, type: 3}
  - text: "Choose wisely\u2026 place your offering in the basket\u2026 and unlock
      the path forward in the Logic Realm."
    voiceClip: {fileID: 8300000, guid: a31109c1ae21450489419d0d35a5b474, type: 3}
  - text: "Good luck\u2026 student. Use your logic\u2026 and press onward."
    voiceClip: {fileID: 8300000, guid: b07f2528394bfdc4e933a0b90dbea752, type: 3}
  finalDialogueEntries: []
  successEntries: []
  failEntries: []
  areAllTasksCompleted: 0
