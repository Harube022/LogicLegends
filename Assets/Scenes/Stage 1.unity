  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WizardInteraction
  wizardObjectiveText: {fileID: 1606873356}
  taskToActivate: {fileID: 1828827739}
  startsTimer: 1
  timerDuration: 180
  dialogueLines:
  - Welcome Student to the first challenge of Stage One!
  - In this stage, the challenge you will learn is how the AND logic gate works.
  - "The AND (\u2227) gate is a logical operator that checks two conditions."
  - It will only give a TRUE result when both inputs are TRUE.
  - TRUE AND TRUE = TRUE
  - If one or both inputs are FALSE, the result will be FALSE.
  - TRUE AND FALSE = FALSE
  - In this challenge, you must open the gate in front to proceed to the next challenge.
  - Remember, you can only open the gate if BOTH switches are ON.
  - 'If one switch is OFF, the gate will stay closed. '
  - Find a way and investigate the area that might help you open the gate.
  - Good Luck!
  finalDialogueLines: []
  nextSceneName: 
  successLines: []
  failLines: []
  OnWizardInteract:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 5100998848913764055}
        m_TargetAssemblyTypeName: WizardInteraction, Assembly-CSharp
        m_MethodName: StartStandardDialogue
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1868145327}
