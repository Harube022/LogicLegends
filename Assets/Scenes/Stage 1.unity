--- !u!114 &2390305704743875737
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6067689569797117584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a0d0127122b22e4684ad51992c5bc3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WizardInteraction
  wizardObjectiveText: {fileID: 2045987540}
  taskToActivate: {fileID: 1348011995}
  startsTimer: 1
  timerDuration: 300
  nextSceneName: 
  OnWizardInteract:
    m_PersistentCalls:
      m_Calls: []
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 119752684}
        m_TargetAssemblyTypeName: DynamicObjectiveIndicator, Assembly-CSharp
        m_MethodName: ActivateArrows
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  OnPuzzleSuccess:
    m_PersistentCalls:
      m_Calls: []
  OnPuzzleFail:
    m_PersistentCalls:
      m_Calls: []
  taskScribbleClip: {fileID: 8300000, guid: d234e554f0fb2b2448ef89d299351b19, type: 3}
  scribbleVolume: 0.5
  wizardVoiceSource: {fileID: 6067689569797117588}
  wizardTalkVolume: 0.7
  dialogueEntries:
  - text: "Welcome\u2026 to the final challenge of Stage One: Logical Expressions."
    voiceClip: {fileID: 8300000, guid: 27bb7efcfa78fad488a4da37600bac89, type: 3}
  - text: "In this trial\u2026 you will learn how the NOT logic gate works."
    voiceClip: {fileID: 8300000, guid: 3923dface5b0d6744bd0cc591abf468c, type: 3}
  - text: "The NOT gate reverses a logical value\u2026\r\nIf something is FALSE\u2026
      applying NOT makes it TRUE."
    voiceClip: {fileID: 8300000, guid: 29d72c2ad49fbcc48be97be4536a5fd5, type: 3}
  - text: "In simple terms\u2026 NOT means the opposite."
    voiceClip: {fileID: 8300000, guid: 9d8251f6cfdb02e4abc38b7a0c06541c, type: 3}
  - text: "To complete this challenge\u2026 you must cross the river\u2026 and reach
      the other side."
    voiceClip: {fileID: 8300000, guid: 33162b1e506a55548b5ac0de7c526c5c, type: 3}
  - text: Your path lies upon a series of lily pads.
    voiceClip: {fileID: 8300000, guid: ac49cff4e92b164428b8332c1cd4e4a7, type: 3}
  - text: "There are three types you must understand\u2026"
    voiceClip: {fileID: 8300000, guid: 77ce4fe7d1ebab840b72d5901be292b9, type: 3}
  - text: "Counterclockwise spinning lily pads\u2026 are safe to step on."
    voiceClip: {fileID: 8300000, guid: 509e9c43f6122134695f5ac1d960edcc, type: 3}
  - text: "Static lily pads\u2026 are also safe."
    voiceClip: {fileID: 8300000, guid: ac0c41e53062b134b8e90334b3b69e93, type: 3}
  - text: "But clockwise spinning lily pads\u2026 are NOT safe."
    voiceClip: {fileID: 8300000, guid: 3cc23fc501c24bd43b8169d68b04f6fa, type: 3}
  - text: "Step upon a forbidden pad\u2026 and it will spin faster\u2026 causing
      you to fall into the water\u2026 and lose a heart.\r\n"
    voiceClip: {fileID: 8300000, guid: ae6dc65c0f3428942a95b8d9abebd587, type: 3}
  - text: "Observe their movement carefully\u2026\r\nThink before you act\u2026"
    voiceClip: {fileID: 8300000, guid: 82865a2e06ad58746a4c5a5ba7449d31, type: 3}
  - text: "Good luck\u2026 student. Every step demands logic\u2026 and precise timing."
    voiceClip: {fileID: 8300000, guid: 04e2e3579ad07214ba601c8af46f2f88, type: 3}
  finalDialogueEntries: []
  successEntries: []
