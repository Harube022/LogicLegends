  OnPuzzleSuccess:
    m_PersistentCalls:
      m_Calls: []
  OnPuzzleFail:
    m_PersistentCalls:
      m_Calls: []
  taskScribbleClip: {fileID: 8300000, guid: d234e554f0fb2b2448ef89d299351b19, type: 3}
  scribbleVolume: 0.5
  wizardVoiceSource: {fileID: 7732147390847379479}
  wizardTalkVolume: 0.7
  dialogueEntries:
  - text: "Welcome, student\u2026 to the first challenge of Stage One."
    voiceClip: {fileID: 8300000, guid: a8a92456464da6c4eb0726937c88469d, type: 3}
  - text: In this trial, you will learn how the AND logic gate works.
    voiceClip: {fileID: 8300000, guid: a24cf8e3e42022840a214973cf4eb2e4, type: 3}
  - text: "The AND (\u2227) gate is a logical operator that evaluates two conditions\u2026
      and yields TRUE only when both inputs are TRUE."
    voiceClip: {fileID: 8300000, guid: 0dbcbb8ad0faaf0439eaa29b6183ad05, type: 3}
  - text: "TRUE\u2026 and TRUE\u2026 results in TRUE."
    voiceClip: {fileID: 8300000, guid: d75f8dfb37fc8804fbc84d23e223b0c2, type: 3}
  - text: "However\u2026 if one or both inputs are FALSE\u2026 the result will be
      FALSE."
    voiceClip: {fileID: 8300000, guid: abcac04b24e7e454d886db6170241f38, type: 3}
  - text: "TRUE\u2026 and FALSE\u2026 results in FALSE."
    voiceClip: {fileID: 8300000, guid: 09e31dd205c0bfb49829cda0818f58fe, type: 3}
  - text: "Before you stands a gate\u2026 blocking your path forward."
    voiceClip: {fileID: 8300000, guid: 3f5f7e7d4e23bf940be97b0799326b68, type: 3}
  - text: "To proceed\u2026 you must open it.\r\nRemember this well\u2026 the gate
      will open only when BOTH pressure plate are turned ON."
    voiceClip: {fileID: 8300000, guid: ffcd45a23f9bb3c468fc537238b5b113, type: 3}
  - text: "If even one remains OFF\u2026 the gate shall stay closed."
    voiceClip: {fileID: 8300000, guid: ae23ad7f4bb7046459affa60a99d3782, type: 3}
  - text: "Search the area\u2026 observe carefully\u2026 and uncover what may aid
      you in solving this challenge.\r\nGood luck\u2026"
    voiceClip: {fileID: 8300000, guid: dbbb42ae2feeaee428ff9f642f831c5a, type: 3}
  finalDialogueEntries: []
  successEntries: []
  failEntries: []
  areAllTasksCompleted: 0
