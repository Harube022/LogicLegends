  m_Script: {fileID: 11500000, guid: d1908f4dda07515458622fb06228cf34, type: 3}
  m_Name: SIMP
  m_EditorClassIdentifier: Assembly-CSharp::LogicLegends.Inference.InferenceRule
  ruleName: Simplification
  abbreviation: SIMP
  instruction: A conjunction guarantees each of its parts. Infer p.
  forms:
  - premises:
    - tokens:
      - '{p}'
      - '[AND]'
      - '{q}'
    conclusion: '{p}'
    distractors:
    - NOT ({p})
    - NOT ({q})
    - '{r}'
  examples:
  - title: Weather
    statements:
    - It is raining
    - The ground is wet
    - The grass is slippery
    - The path is closed
    aliases:
    - It's raining
    - 
    - 
    - 
  - title: Temple
    statements:
    - The torch is lit
    - The gate is open
    - The bell is ringing
    - The bridge is lowered
    aliases: []
  - title: Study
    statements:
    - Sara studies
    - Sara passes the quiz
    - Lee practices
    - Lee solves the puzzle
    aliases: []
  - title: Garden
    statements:
    - The seed is planted
    - The flower grows
    - The sun is shining
    - The soil is warm
    aliases: []
  - title: Library
    statements:
    - I make tea
    - I read a book
    - I take notes
    - I remember the lesson
    aliases: []
  - title: Morning
    statements:
    - Sara wakes up early
    - Sara exercises
    - Lee stays up late
    - Lee drinks coffee
    aliases: []
