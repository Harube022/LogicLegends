  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75b281f0556ee944886e8b4b3a8b66d9, type: 3}
  m_Name: WizardVoiceCatalog
  m_EditorClassIdentifier: Assembly-CSharp::WizardVoiceCatalog
  lines:
  - id: garden_01
    subtitle: "Welcome to LogicGarden. I\u2019m Lefyahj, your guide."
    clip: {fileID: 8300000, guid: 78230ad7eaab26d49b5be845080670b0, type: 3}
  - id: garden_02
    subtitle: This is a safe realm where you can prepare for your journey through
      Discrete Mathematics.
    clip: {fileID: 8300000, guid: 795a0e8926aa6774e8249ba02103d256, type: 3}
  - id: garden_03
    subtitle: "The Logic Library holds the topics you\u2019ll explore, from prelims
      through finals."
    clip: {fileID: 8300000, guid: 4ec3ca7cf3c62874bb94c10324bbe87a, type: 3}
  - id: garden_04
    subtitle: Visit the library to learn about these topics and prepare for the challenges
      ahead.
    clip: {fileID: 8300000, guid: 63e7edbf21bb3dc42a6b1d7c00bf3008, type: 3}
  - id: garden_05
    subtitle: "The entrance is now open. Head to the Logic Library when you\u2019re
      ready."
    clip: {fileID: 8300000, guid: 02e6fb592417d16479dda3e34c9e9c21, type: 3}
  - id: library_01
    subtitle: Welcome to the Logic Library.
    clip: {fileID: 8300000, guid: a006a3b255f71444fb87fee48a74fe4e, type: 3}
  - id: library_02
    subtitle: Here, you can explore Discrete Mathematics topics from prelims through
      finals.
    clip: {fileID: 8300000, guid: 89be88b2067d242428a65c23ccd5dac5, type: 3}
  - id: library_03
    subtitle: Approach a shelf and tap the hand button. Choose a topic to open its
      book.
    clip: {fileID: 8300000, guid: 2bd9d2164e29cbb43b0c99b640c627e6, type: 3}
  - id: library_04
    subtitle: "Take your time learning. You can return to LogicGarden whenever you\u2019re
      ready."
    clip: {fileID: 8300000, guid: daf7bdda08cd2b4419e13a8a2b6dd591, type: 3}
  - id: tour_prelim
    subtitle: PRELIM covers propositional logic, truth tables, and rules of inference.
      These books explain propositions, logical connectives, truth values, and valid
      arguments.
    clip: {fileID: 8300000, guid: 63fe8fdc2b7a8414aa9eda8fb0b29fc5, type: 3}
  - id: tour_midterms
    subtitle: MIDTERMS covers formal and informal proofs, followed by direct and
      indirect proofs. Learn how to structure a proof and use deduction, contradiction,
      and the contrapositive.
    clip: {fileID: 8300000, guid: 39e0fb604146f8b4b86a072bc52415aa, type: 3}
  - id: tour_prefinals
    subtitle: PRE-FINALS contains mathematical induction, sets, and functions and
      relations. Explore induction proofs, set operations and complements, ordered
      pairs, and mappings.
    clip: {fileID: 8300000, guid: d8c89c0b34863c44a9a03676d4ade065, type: 3}
  - id: tour_finals
    subtitle: FINALS introduces graphs and trees. Learn about vertices, edges, degree,
      paths and cycles, then explore tree terminology, tree types, and spanning trees.
    clip: {fileID: 8300000, guid: 4fea11ff12bbbc84082262fc5b6833f1, type: 3}
  - id: tour_confirm
    subtitle: Did you get all that?
    clip: {fileID: 8300000, guid: 6eb4a8d73d9411045afb76b4346a83ee, type: 3}
  - id: return_question
    subtitle: Would you like to return to the garden?
    clip: {fileID: 8300000, guid: 99efaef971e9e9543b3c2f9065993a6e, type: 3}
