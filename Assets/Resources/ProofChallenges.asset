  - kind: 2
    title: Missing Justification
    instructions: Select a RULE tablet and place it on RULE SLOT 1.
    context: "1. P \u2014 Premise    2. P \u2192 Q \u2014 Premise    3. Q \u2014
      [MISSING JUSTIFICATION]"
    scrolls: []
    steps: []
    acceptableOrders: []
    ruleOptions:
