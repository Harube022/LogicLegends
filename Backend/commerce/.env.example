# Local sandbox: writes to the database emulator, never to your real accounts.
STORAGE_MODE=emulator
# New economy stays disconnected after a merge. Programmer enables after testing.
SOLO_ECONOMY_V2_ENABLED=false
PAYMENT_MODE=test
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_PROJECT_ID=logic-legends-ac66c
FIREBASE_DATABASE_URL=https://logic-legends-ac66c-default-rtdb.asia-southeast1.firebasedatabase.app
PORT=18080
PUBLIC_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET=REPLACE_ME
PAYMENT_METHODS=qrph
# Optional sandbox switch to pause new top-ups. For live payments the switch
# must be explicitly true; it does not replace LIVE_WALLET_READY.
CHECKOUT_ENABLED=true
# Social messages/invites: independent of COMMERCE_ENABLED and payment settings.
CHAT_CLEANUP_ENABLED=false
CHAT_CLEANUP_INTERVAL_MINUTES=15
# Optional external scheduler POST /internal/chat-cleanup; use a private random
# token of at least 32 characters on Render and the scheduler, never in Unity.
# CHAT_CLEANUP_TOKEN=
# External hosting only: STORAGE_MODE=firebase, PAYMENT_MODE=live; REMOVE
# FIREBASE_DATABASE_EMULATOR_HOST; set PUBLIC_BASE_URL to your host's HTTPS URL.
# Use GOOGLE_APPLICATION_CREDENTIALS=/private/path/service-account.json OR a
# FIREBASE_SERVICE_ACCOUNT_JSON secret managed by your hosting provider.
# Set LIVE_WALLET_READY=true only after completing the launch checks in README.
