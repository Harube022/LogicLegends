[
  {
    "text": "Stay awhile\u2026",
    "width": 380.0,
    "seconds": 1.36,
    "characters_per_second": 8.823529411764705
  },
  {
    "text": "and listen\u2026",
    "width": 335.0,
    "seconds": 1.7199999999999993,
    "characters_per_second": 6.395348837209305
  },
  {
    "text": "Beyond the world you know\u2026",
    "width": 859.96875,
    "seconds": 2.6799999999999997,
    "characters_per_second": 9.701492537313435
  },
  {
    "text": "lies a realm\u2026",
    "width": 383.984375,
    "seconds": 2.280000000000001,
    "characters_per_second": 5.701754385964909
  },
  {
    "text": "shaped by logic\u2026",
    "width": 494.984375,
    "seconds": 1.6000000000000014,
    "characters_per_second": 9.999999999999991
  },
  {
    "text": "A world governed",
    "width": 510.984375,
    "seconds": 2.2200000000000024,
    "characters_per_second": 7.207207207207199
  },
  {
    "text": "not by chaos\u2026",
    "width": 417.984375,
    "seconds": 2.6999999999999957,
    "characters_per_second": 4.814814814814822
  },
  {
    "text": "but by truth\u2026",
    "width": 398.984375,
    "seconds": 2.0199999999999996,
    "characters_per_second": 6.435643564356437
  },
  {
    "text": "reasoning and structure\u2026",
    "width": 748.96875,
    "seconds": 3.039999999999999,
    "characters_per_second": 7.8947368421052655
  },
  {
    "text": "The Logic Realm\u2026",
    "width": 520.0,
    "seconds": 1.7199999999999989,
    "characters_per_second": 9.302325581395355
  },
  {
    "text": "At its core\u2026",
    "width": 342.984375,
    "seconds": 1.8200000000000003,
    "characters_per_second": 6.593406593406592
  },
  {
    "text": "stands the Pillar of Logic\u2026",
    "width": 760.0,
    "seconds": 4.039999999999999,
    "characters_per_second": 6.683168316831685
  },
  {
    "text": "The force that binds",
    "width": 583.984375,
    "seconds": 2.559999999999995,
    "characters_per_second": 7.812500000000015
  },
  {
    "text": "all knowledge\u2026",
    "width": 448.984375,
    "seconds": 1.4399999999999977,
    "characters_per_second": 9.722222222222237
  },
  {
    "text": "into balance\u2026",
    "width": 408.0,
    "seconds": 2.0799999999999983,
    "characters_per_second": 6.250000000000005
  },
  {
    "text": "But now\u2026",
    "width": 290.984375,
    "seconds": 1.3800000000000026,
    "characters_per_second": 5.797101449275352
  },
  {
    "text": "something is wrong\u2026",
    "width": 617.984375,
    "seconds": 1.6799999999999997,
    "characters_per_second": 11.309523809523812
  },
  {
    "text": "The Pillar falters\u2026",
    "width": 525.0,
    "seconds": 2.559999999999995,
    "characters_per_second": 7.421875000000014
  },
  {
    "text": "And the very logic",
    "width": 519.0,
    "seconds": 3.0799999999999983,
    "characters_per_second": 5.844155844155847
  },
  {
    "text": "that shapes this realm\u2026",
    "width": 698.984375,
    "seconds": 2.720000000000006,
    "characters_per_second": 8.455882352941158
  },
  {
    "text": "begins to fade\u2026",
    "width": 460.0,
    "seconds": 3.0,
    "characters_per_second": 5.0
  },
  {
    "text": "As understanding fades\u2026",
    "width": 733.0,
    "seconds": 4.6200000000000045,
    "characters_per_second": 4.978354978354973
  },
  {
    "text": "in your world\u2026",
    "width": 435.0,
    "seconds": 2.5799999999999983,
    "characters_per_second": 5.42635658914729
  },
  {
    "text": "So too\u2026",
    "width": 233.0,
    "seconds": 1.480000000000004,
    "characters_per_second": 4.729729729729717
  },
  {
    "text": "does this realm begin to collapse\u2026",
    "width": 1002.984375,
    "seconds": 3.780000000000001,
    "characters_per_second": 8.994708994708992
  },
  {
    "text": "The foundation of",
    "width": 521.0,
    "seconds": 2.680000000000007,
    "characters_per_second": 6.343283582089536
  },
  {
    "text": "Discrete Mathematics\u2026",
    "width": 683.984375,
    "seconds": 1.6200000000000045,
    "characters_per_second": 12.962962962962926
  },
  {
    "text": "forgotten\u2026",
    "width": 324.984375,
    "seconds": 2.299999999999997,
    "characters_per_second": 4.347826086956527
  },
  {
    "text": "But all is not yet lost\u2026",
    "width": 643.0,
    "seconds": 4.240000000000009,
    "characters_per_second": 5.660377358490554
  },
  {
    "text": "The Logic Guardian",
    "width": 558.984375,
    "seconds": 1.8400000000000034,
    "characters_per_second": 9.782608695652156
  },
  {
    "text": "calls upon chosen minds\u2026",
    "width": 760.0,
    "seconds": 3.9399999999999977,
    "characters_per_second": 6.091370558375638
  },
  {
    "text": "And here\u2026",
    "width": 313.984375,
    "seconds": 1.460000000000008,
    "characters_per_second": 6.164383561643802
  },
  {
    "text": "your journey begins\u2026",
    "width": 625.984375,
    "seconds": 2.460000000000008,
    "characters_per_second": 8.130081300812982
  },
  {
    "text": "To restore balance\u2026",
    "width": 590.90625,
    "seconds": 2.9599999999999937,
    "characters_per_second": 6.418918918918933
  },
  {
    "text": "and reclaim the logic",
    "width": 605.984375,
    "seconds": 3.0799999999999983,
    "characters_per_second": 6.818181818181822
  },
  {
    "text": "that has been lost\u2026",
    "width": 572.0,
    "seconds": 2.5000000000000284,
    "characters_per_second": 7.5999999999999135
  }
]